# Локальные переменные для `supabase functions serve --env-file supabase/functions/.env`.
# Скопируй в supabase/functions/.env. Значения ниже — фейковые, только для тестов на локальном стенде.
TELEGRAM_BOT_TOKEN=123456:local-test-token-not-real
TELEGRAM_WEBHOOK_SECRET=local-webhook-secret
ALLOWED_ORIGINS=http://localhost:8765
SITE_URL=http://localhost:8765/
