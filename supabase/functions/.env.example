# Локальные переменные для `supabase functions serve --env-file supabase/functions/.env`.
# Скопируй в supabase/functions/.env. Значения ниже — фейковые, только для тестов на локальном стенде.
TELEGRAM_BOT_TOKEN=123456:local-test-token-not-real
TELEGRAM_WEBHOOK_SECRET=local-webhook-secret
ALLOWED_ORIGINS=http://localhost:8765
SITE_URL=http://localhost:8765/
# Внешние сервисы — заглушка тестов (tests/stub.py, её поднимают сами тесты): проверки не ходят в интернет и не висят
# на медленной сети. На бою эти переменные не задаём — там настоящие адреса (supabase/functions/_shared/hosts.ts).
TELEGRAM_API_URL=http://host.docker.internal:54390/telegram
NOMINATIM_URL=http://host.docker.internal:54390/nominatim
NPM_CDN_URL=http://host.docker.internal:54390/npm
S3_URL=http://host.docker.internal:54390/s3
# ключ к бакету фото (функция photos) — на стенде любой: запросы уходят в заглушку
PHOTOS_S3_KEY_ID=local-test-key
PHOTOS_S3_SECRET=local-test-secret
